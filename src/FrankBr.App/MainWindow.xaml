<Window x:Class="FrankBr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrankBr Design Studio"
        Width="1450"
        Height="880"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#0D1520" Foreground="#F8FAFC">
            <MenuItem Header="Arquivo">
                <MenuItem Header="Importar imagem..." Click="ImportImage_Click" InputGestureText="Ctrl+I" />
                <Separator />
                <MenuItem Header="Sair" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="Editar" />
            <MenuItem Header="Projeto" />
            <MenuItem Header="Ferramentas" />
            <MenuItem Header="Plugins" />
            <MenuItem Header="Ajuda" />
        </Menu>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Novo projeto" />
                <Button Content="Abrir" />
                <Button Content="Salvar" />
                <Separator Margin="8,0" />
                <Button Content="Importar imagem" Click="ImportImage_Click" />
                <Button Content="Excluir" Click="DeleteSelected_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="285" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="14">
                    <TextBlock Text="TEMPLATES" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                    <Expander Header="ETS2" IsExpanded="True"><TextBlock Text="Scania • Volvo • DAF" Margin="20,8" Foreground="{StaticResource MutedTextBrush}" /></Expander>
                    <Expander Header="ATS"><TextBlock Text="Kenworth • Peterbilt" Margin="20,8" Foreground="{StaticResource MutedTextBrush}" /></Expander>
                    <Expander Header="Ônibus" />
                    <Expander Header="Uniformes" />
                    <Separator Margin="0,18" />
                    <TextBlock Text="PROJETO" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="NovoProjeto.frankbr" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Background="#0B111A">
                <ScrollViewer x:Name="CanvasScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="40">
                    <Border Width="716.8" Height="716.8" BorderBrush="#4D6480" BorderThickness="1" SnapsToDevicePixels="True">
                        <Border.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#D9DEE5" Geometry="M0,0 H32 V32 H0 Z" />
                                        <GeometryDrawing Brush="#BFC7D1" Geometry="M0,0 H16 V16 H0 Z M16,16 H32 V32 H16 Z" />
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                        <Canvas x:Name="DesignCanvas"
                                Width="716.8"
                                Height="716.8"
                                Background="Transparent"
                                MouseLeftButtonDown="DesignCanvas_MouseLeftButtonDown">
                            <ItemsControl ItemsSource="{Binding Images}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                BorderThickness="2"
                                                Background="Transparent"
                                                MouseLeftButtonDown="ImageItem_MouseLeftButtonDown"
                                                MouseMove="ImageItem_MouseMove"
                                                MouseLeftButtonUp="ImageItem_MouseLeftButtonUp">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#2F81F7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Source="{Binding Source}" Stretch="Fill" IsHitTestVisible="False" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="PROPRIEDADES" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="SelectionNameText" Text="Nenhum objeto selecionado" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="SelectionPositionText" Text="Canvas: 2048 × 2048 px" Margin="0,12,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="CAMADAS" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,10" />
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Images}"
                             DisplayMemberPath="Name"
                             SelectionChanged="Layers_SelectionChanged" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#0D1520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Zoom: 35%" VerticalAlignment="Center" Margin="0,0,24,0" />
                <TextBlock x:Name="MouseXText" Grid.Column="1" Text="X: 0" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock x:Name="MouseYText" Grid.Column="2" Text="Y: 0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="Canvas: 2048 × 2048 px  •  NovoProjeto.frankbr" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
